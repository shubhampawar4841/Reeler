# Copy to `.env` / `.env.local`

# Optional: override bundled ffmpeg-static
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

BACKGROUND_MUSIC_VOLUME=0.18

# Pexels (Authorization header)
PEXELS_API_KEY=

# Groq LLM (story → timed scenes)
GROQ_API_KEY=
# Prefer llama-3.3-70b-versatile for JSON. gpt-oss-120b works but needs high max_tokens (set in code).
GROQ_MODEL=llama-3.3-70b-versatile
# Whisper for story VO → word caption sync (story-video pipeline)
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Free tier TPM ~12000 counts prompt + max_tokens — keep these under budget
GROQ_TPM_BUDGET=12000
GROQ_MAX_TOKENS=3500

# Kokoro TTS via npm `kokoro-js` (English — no separate server)
KOKORO_VOICE=am_fenrir
# Optional: q8 | fp32 | fp16 | q4 | q4f16
KOKORO_DTYPE=q8
# Speaking rate (1.0 default; 1.15–1.25 good for Shorts)
KOKORO_SPEED=1.18
# Hindi uses Edge TTS until kokoro-js ships hf_/hm_ voices (hm_omega-like male)
HINDI_EDGE_VOICE=hi-IN-MadhurNeural
# HINDI_EDGE_VOICE=hi-IN-SwaraNeural

# Story renderer: ffmpeg (default) | remotion (Phase 2+ wired)
STORY_RENDERER=ffmpeg
# Remotion intro/outro cards (ON by default when using remotion). Set 0 to disable.
# STORY_REMOTION_INTRO=0

# YouTube (personal channel — Web OAuth client)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID → Web application
# Authorized JS origins: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
# Paste after visiting /auth/youtube once
YOUTUBE_REFRESH_TOKEN=
