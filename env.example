# Copy to `.env` / `.env.local`

# Optional: override bundled ffmpeg-static
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

BACKGROUND_MUSIC_VOLUME=0.18

# Pexels (Authorization header)
PEXELS_API_KEY=
# When set to "auto" and no brollId is passed, stitch ~8 short Pexels clips into one montage
# PEXELS_BROLL_MODE=auto

# Groq LLM (Whisper + story planner fallback)
GROQ_API_KEY=
# Prefer llama-3.3-70b-versatile for JSON. gpt-oss-120b works but needs high max_tokens (set in code).
GROQ_MODEL=llama-3.3-70b-versatile
# Whisper for story VO → word caption sync (story-video pipeline)
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Paid/dev TPM — raise if you hit rate limits. Free tier may need ~12000.
GROQ_TPM_BUDGET=30000
# Larger completion = full retells instead of forced summaries
GROQ_MAX_TOKENS=5000

# Gemini (primary story planner). Falls back to Groq if missing/fails.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_TOKENS=8192

# Kokoro TTS via npm `kokoro-js` (English — no separate server)
KOKORO_VOICE=af_heart
# Alternatives: af_bella, af_sarah, af_nicole · male: am_fenrir, am_adam
# Optional: q8 | fp32 | fp16 | q4 | q4f16
KOKORO_DTYPE=q8
# Speaking rate (1.0 default; 1.15–1.25 good for Shorts)
KOKORO_SPEED=1.18
# Hindi uses Edge TTS until kokoro-js ships hf_/hm_ voices (hm_omega-like male)
HINDI_EDGE_VOICE=hi-IN-MadhurNeural
# HINDI_EDGE_VOICE=hi-IN-SwaraNeural

# Story visual mux: ffmpeg (default = continuous B-roll + ASS captions)
# | remotion (karaoke captions)
STORY_RENDERER=ffmpeg
# STORY_RENDERER=remotion
# Whole Short speed (B-roll + speech + captions). 1.35 default; auto-raised to stay ≤3:00.
# STORY_SPEED=1.35
# MAX_SHORTS_SEC=179

# YouTube (personal channel — Web OAuth client)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID → Web application
# Authorized JS origins: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
# Paste after visiting /auth/youtube once
YOUTUBE_REFRESH_TOKEN=

# YouTube cookies (Netscape cookies.txt) — required on Vercel / GitHub Actions.
# Without these, datacenter IPs get LOGIN_REQUIRED / "confirm you're not a bot".
# Export from a logged-in browser (extension: "Get cookies.txt LOCALLY"), then:
#   - Vercel → Project → Settings → Environment Variables → YT_DLP_COOKIES
#   - GitHub → repo Settings → Secrets → YT_DLP_COOKIES
# YT_DLP_COOKIES=
# Or a file path for local/CI runners:
# YT_DLP_COOKIES_FILE=./cookies.txt
